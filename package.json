{
  "name": "localhost-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "biome lint extension local-helper.mjs tests scripts",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "check": "npm run lint && node scripts/check-modules.mjs && npm test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "playwright": "^1.65.0"
  }
}

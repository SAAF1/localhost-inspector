{
  "files": {
    "includes": [
      "extension/**",
      "integrations/**",
      "*.mjs",
      "tests/**",
      "scripts/**"
    ]
  },
  "overrides": [{
    "includes": ["extension/**", "integrations/**", "scripts/**", "*.mjs"],
    "linter": { "rules": { "style": {
      "noExcessiveLinesPerFile": { "level": "warn", "options": { "maxLines": 300 } }
    } } }
  }],
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnreachable": "error",
        "noUnsafeFinally": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noDuplicateObjectKeys": "error",
        "noVar": "error"
      },
      "style": {
        "useConst": "error"
      },
      "preset": "none"
    }
  }
}
